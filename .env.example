# Discord bot token. DISCORD_TOKEN is also accepted for compatibility
# with the previous Rem bot configuration.
DISCORD_BOT_TOKEN=

# The existing Master Discord user ID. Identity is resolved from this ID only.
MASTER_DISCORD_ID=992390617575477268

# Keep the old working Gemini model as the default; override here to change it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback for Rem's conversation agent. The chosen model is the
# existing preference from Rem's previous implementation.
GROQ_API_KEY=
GROQ_REM_MODEL=openai/gpt-oss-120b
# Multimodal fallback for image messages; GPT-OSS 120B is text-only.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional. If set, Agno session history uses PostgreSQL (recommended for VPS).
# The existing NEON_DATABASE_URL is also accepted. A local SQLite database is
# used only when neither variable is set, for first-run development/testing.
AGNO_DATABASE_URL=
NEON_DATABASE_URL=
SQLITE_SESSION_DB=data/rem_agno_sessions.db

# Beta rollout safety: allow only listed text-channel IDs (comma-separated).
# Leave blank to ignore all guild messages while allowing Master DMs.
# Set to "all" only when you're ready for Rem to process the whole server.
REM_ALLOWED_CHANNEL_IDS=

# Number of past Agno runs included in the session context. The bot also loads
# up to 20 reply ancestors (6,000 characters) and nearby channel discussion.
AGNO_HISTORY_RUNS=20
LOG_LEVEL=INFO

# AI moderation keeps the previous policy: Gemini classifier, Groq GPT-OSS 20B fallback.
# The same GROQ_API_KEY is used by both moderation and the optional GPT-OSS 120B reply fallback.
# Required Discord developer portal intents: Message Content and Server Members.

# Proactive long-term memory (Agno curator + Mem0 OSS 2.2.1).
# Optional override for the existing Neon URL. The beta uses distinct table names
# and a separate Mem0 collection, so the existing Neon branch can be reused.
REM_MEMORY_DATABASE_URL=
REM_MEMORY_COLLECTION=rem_agno_beta_memory_index
REM_MEMORY_MODEL=gemini-3.5-flash-lite
REM_MEM0_LLM_MODEL=gemini-3.5-flash-lite
REM_MEM0_EMBEDDER_MODEL=models/gemini-embedding-001
REM_MEM0_EMBEDDING_DIMS=768
REM_MEMORY_MIN_WORDS=7
REM_MEMORY_REVIEW_EVERY=5
REM_MEMORY_EVENT_RETENTION_DAYS=30
